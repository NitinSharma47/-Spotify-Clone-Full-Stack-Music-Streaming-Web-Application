{
  "name": "spotify-clone-backend",
  "version": "1.0.0",
  "description": "REST API backend for a full-stack Spotify-inspired music streaming web app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node database/seed.js",
    "seed:force": "node database/seed.js --force",
    "fetch-previews": "node database/fetch_real_previews.js",
    "fetch-previews:force": "node database/fetch_real_previews.js --force",
    "test-matching": "node database/test_matching_logic.js"
  },
  "keywords": ["spotify-clone", "music-streaming", "nodejs", "express", "mysql"],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
